# Downloaded and cached source data (5.6 GB). Everything here is rebuilt by the scripts, and
# the paper atlas it caches is licensed CC BY-NC-ND, so it must not be redistributed.
data/

# A separate 23 GB project tree with its own repository.
attempted_projects/

# Run logs: one file per paper, plus per-run console output. Local history, not source.
logs/
run.out

# Generated reports. PROJECTS.md and projects.csv are rebuilt by scripts/rank.py.
reports/
PROJECTS.md
projects.csv

__pycache__/
*.pyc
.DS_Store

# Working files the evaluation agents left in the repo: downloaded supplements, one-off probe
# scripts, 65 MB of data under scratchpad/. None of it is source, and some of it is licensed
# material from publishers.
scratchpad/
scratch_scripts/
moesm2.txt

# The live dashboard, rewritten every minute by scripts/dashboard.py --watch.
# The committed snapshot is docs/dashboard.html.
/dashboard.html
