  "backbone": {"name": "ESM-2 (protein language model) on the 1,559 transcription factor sequences, or DNABERT-2 / Nucleotide Transformer on promoter sequences", "freeze_and_head_viable": true, "hardware": "Laptop CPU; 1,559 proteins embed in well under an hour with a small ESM-2 checkpoint", "licence": "ESM-2 MIT; ChEA-KG user interface code is GPL-3.0, data licence not stated on the download page"},
  "integration": {"partner_dataset": "KnockTF2 or similar measured transcription-factor knockdown/knockout RNA-sequencing compendia, and TRRUST literature-curated edges", "join_key": "NCBI Gene ID / HGNC gene symbol, both present in the edge files", "bigger_question_one_sentence": "Does an enrichment-derived network like ChEA-KG predict what actually happens to a transcription factor's expression when its proposed regulator is knocked down, better than literature-curated or motif-based networks do?"},
  "controls": {"positive_control": "The model should recover well-known transcription factor pairs such as SRY-ZFY and the MYC/MAX module, and should nail a trivially derivable target like protein length from sequence.", "negative_control": "Shuffle edge signs and confirm collapse to the 52%-upregulating majority baseline; degree-only baseline to expose the strong hub bias (CENPA has 588 out-edges).", "external_validation": "TRRUST (2,597 TF-TF edges) and the TRANSFAC/JASPAR position-weight-matrix network (32,067 edges) exist and were used by the authors - but as overlap-enrichment checks, not as held-out accuracy tests."},
  "honest_claim_h3": "A model trained on this file could only claim to predict which transcription factor pairs the ChEA3 enrichment tool links when run across RummaGEO's automatically mined gene sets - not which transcription factor actually regulates which.",
  "plain_idea": {
    "one_liner": "Use transcription factor protein and promoter sequences to predict which factor regulates which, and whether it turns it up or down.",
    "train_on": "The ChEA-KG network: 131,181 signed, directed edges among 1,559 human transcription factors, each with a z-score and p-value, verified by me in the downloaded CSV files.",
    "predict": "Whether an edge exists between two transcription factors and its sign (activation or repression). The 'true answer' is not a measurement - it is the output of the ChEA3 enrichment tool run over automatically mined differential-expression gene sets.",
    "why_worthwhile": "If the labels were measured, this would give sequence-based priors for gene regulatory network builders; because they are not, the only honest version of the project is checking whether ChEA-KG's edges hold up against real knockdown experiments."
  },
  "paper_type": "computational",
  "crowded_field_case": {
    "more_or_better_data": {"answer": "partly", "why": "131,181 signed TF-TF edges over 1,559 factors is larger coverage than TRRUST's 2,597 edges over 800 factors, but it is bigger inferred output, not more measurement."},
    "confidence_score": {"answer": "no", "why": "Each edge carries one z-score and p-value from a single shuffled-network null; there are no replicate measurements, and 25% of p-values are exactly 0 from underflow, so calibrated per-edge confidence is not supported."},
    "models_beatable": {"answer": "partly", "why": "ChEA-KG itself reports no held-out predictive score, only overlap enrichment versus shuffles, so there is no published number to beat; graph neural network competitors (GENELink 2022, DeepTFni 2022, GRNFormer) exist but on single-cell inputs, a different task."},
    "guaranteed_improvement": {"answer": "no", "why": "The condition that fails is the label: any added data would be scored against ChEA3's own output, so a better number means better imitation of ChEA3, not better biology."}
  },
  "label_elsewhere": null,
