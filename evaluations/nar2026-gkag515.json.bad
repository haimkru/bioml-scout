  "leakage_plan": {
    "risks": [
      "The 16S gene is a phylogenetic marker, so a random split puts near-identical relatives in train and test and makes the task look almost solved.",
      "The FAPROTAX trait columns are assigned by looking up the taxon's name, so predicting them from sequence or taxonomy would be pure circularity - they must be excluded from the sequence task.",
      "BacDive has merged its own random-forest predictions into strain records, and this export (dated 2024-11-07) has no column flagging predicted versus measured, so some labels could be another model's output.",
      "Trait records track culture-collection and publication history, so whole families are over- or under-sampled in ways that correlate with the trait.",
      "For some traits the label and the feature are linked by definition (motility and flagellar genes), which is fine biology but will dominate feature-importance stories if not called out."
    ],
    "split": "Leave-whole-family-out using the family token of the 'LPSN Taxonomy' column, which I confirmed is populated for all 27,010 rows and yields 477 families among Gram-labelled organisms, 101 of them with at least 20 members. Add a harder leave-order-out tier and a 16S-identity-clustered split (cluster at 95% and 97% identity with MMseqs2 or VSEARCH, hold out clusters), and report accuracy against identity to the nearest training sequence.",
    "checks": [
      "Shuffle labels globally and within family; performance must collapse to the per-family majority baseline.",
      "For every test organism, compute 16S identity to its closest training sequence and plot accuracy against it - a flat curve at high accuracy means the split failed.",
      "Run a nearest-training-neighbour-only predictor; if it matches the language model everywhere, the model is just doing lookup.",
      "Train on 6-mer counts alone, and on random vectors of the same shape, as the cheap floor and the noise floor."
    ],
    "verdict": "Manageable but central: the grouping column is present and verified, yet phylogenetic leakage is the whole scientific question here, so the headline number is only as good as the split."
  },
  "success_criteria": {
    "metric": "Balanced accuracy per trait on leave-family-out folds, reported as a curve against 16S identity to the nearest training sequence. It matches the decision because the tools make a yes/no call at probability above 0.5, and the paper itself reports balanced accuracy.",
    "baselines": "Majority class (61.5% Gram-negative, so balanced accuracy 0.5 by construction); nearest-16S-neighbour lookup; the paper's published per-trait numbers in Supplementary Dataset S3 (215 rows, opened) and its trait-averaged 0.81 taxonomy / 0.86 metabolic networks / 0.88 machine learning at species rank; BacDive-AI's F1 of 0.95 for Gram-positive on a random split, re-run on our family-held-out split.",
    "success": "On families where the nearest training 16S is below 95% identical: balanced accuracy at or above 0.75 for Gram stain and 0.70 for oxygen tolerance, and at least 0.05 above the nearest-neighbour baseline on the same folds.",
    "noise_ceiling": 0.994,
    "kill": "If after two weeks the 16S language-model head does not beat nearest-16S-neighbour by 0.02 balanced accuracy on held-out families, stop modelling and publish the decay curve and the benchmark table instead."
  },
  "publication_target": {
    "ambitious": {
      "journal": "Genome Biology",
      "why": "Publishes methods of broad use in genomics; it would take the 16S-only model clearly beating both taxonomy lookup and genome gene-content models on families with no characterised relative."
    },
    "realistic": {
      "journal": "Bioinformatics",
      "why": "Publishes benchmarks and evaluation studies of existing tools; a phylogeny-aware comparison of three input types across four traits, with a reusable split and table, is exactly that."
    },
    "fallback": {
      "journal": "NAR Genomics and Bioinformatics",
      "why": "Takes negative and partial results with a useful resource attached, so even 'sequence adds nothing over nearest-neighbour' plus the curated benchmark would land."
