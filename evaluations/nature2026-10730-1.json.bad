      {"name": "MHCflurry 2.0 (open-source HLA class I presentation predictor with a separate antigen-processing model)", "open_weights": true, "score_and_split": "Its processing-plus-binding model gave at least 40% higher positive predictive value than NetMHCpan 4.0 and MixMHCpred 2.0.2 on held-out mass-spectrometry experiments.", "authors_named_unsolved": "Predicting which presented peptides actually trigger a T cell response is still unsolved.", "runnable_as_baseline": true},
      {"name": "MixMHCpred (motif-deconvolution-based HLA class I ligand predictor)", "open_weights": true, "score_and_split": "Median positive predictive value 0.791 on the same eluted-ligand benchmark as NetMHCpan-4.1; reported as best-in-class for most alleles in an independent 2020 benchmark.", "authors_named_unsolved": "Rare alleles and non-canonical peptide lengths.", "runnable_as_baseline": true},
      {"name": "ImmuneApp (2024 deep-learning HLA class I epitope and immunopeptidome analysis tool, Nature Communications)", "open_weights": true, "score_and_split": "Reported to outperform NetMHCpan-4.1 and MHCflurry 2.0 on independent immunopeptidome benchmarks; exact numbers not retrieved.", "authors_named_unsolved": "Immunogenicity, as distinct from presentation.", "runnable_as_baseline": true},
      {"name": "NetMHCpan 4.0 as used inside this very paper", "open_weights": true, "score_and_split": "Applied at a 10% rank cutoff to the 50 synthesised peptides; 23 called binders. No held-out evaluation; the paper reports that non-binders were, unexpectedly, more immunogenic than binders in ELISpot.", "authors_named_unsolved": "The authors note their peptides are longer than canonical HLA-ABC ligands and that binding prediction did not track T cell response.", "runnable_as_baseline": true}
