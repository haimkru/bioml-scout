  "backbone": {"name": "Nucleotide Transformer or DNABERT-2 (DNA language models) would fit mm10 10 kb bins", "freeze_and_head_viable": true, "hardware": "CPU, embeddings cacheable", "licence": "Permissive for both, but irrelevant here because no usable label exists"},
  "integration": {"partner_dataset": "Mouse embryonic stem cell Lamin-B1 DamID and 4D Nucleome TSA-seq tracks, joinable on mm10 coordinates", "join_key": "mm10 genomic coordinates (10 kb bins)", "bigger_question_one_sentence": "Does a sequencing-based geometric reconstruction of the nucleus agree with antibody- and proximity-based measurements of radial position - a question this data cannot answer because the radial positions themselves are not published."},
  "controls": {"positive_control": "Gene-rich regions should sit closer to the nuclear centre. I ran this and it failed: median Spearman 0.08 between gene density per 1 Mb and the centred depth coordinate, with inconsistent sign across the 10 cells.", "negative_control": "Label shuffling would be runnable, but there is no label worth shuffling.", "external_validation": "Mouse embryonic stem cell Lamin-B1 DamID exists publicly, but nothing in the download can be compared to it on a per-locus basis."},
  "honest_claim_h3": "The strongest honest claim any model built on the downloadable files could make is 'this predicts which cryosection of one of ten mouse embryonic stem cells a 10 kb genomic bin was sequenced in', which is a statement about the cutting geometry of that one cell, not about nuclear organisation.",
  "plain_idea": {
    "one_liner": "Use DNA sequence to predict how far a genomic region sits from the centre of the cell nucleus.",
    "train_on": "10 kb windows of the mouse genome (254,937 distinct windows appear across the files) with their measured position in the nucleus, from 10 single cells of one mouse embryonic stem cell line.",
    "predict": "The distance of each window from the nuclear centre. The true answer was meant to come from slicing a fixed nucleus into 200 nm sections, sequencing each section, and reconstructing 3D coordinates - but only the section-depth coordinate was deposited, not the reconstructed distance.",
    "why_worthwhile": "Groups studying nuclear architecture would like a sequence-only predictor of radial position to extend to cell types nobody can section; even a failure would tell us whether section-based depth data carries any reproducible radial signal."
  },
  "paper_type": "experimental",
  "crowded_field_case": {
    "more_or_better_data": {"answer": "no", "why": "10 cells of one mouse embryonic stem cell line from one lab, versus LADDER (Patterns 2026), which trained on genome-wide lamina-association maps across several mammalian species."},
    "confidence_score": {"answer": "no", "why": "There are 10 cells, and I measured their mutual agreement on the per-locus depth coordinate at a median Spearman of 0.01, so per-prediction uncertainty would be dominated by noise with no way to separate biological heterogeneity from sectioning artefact."},
    "models_beatable": {"answer": "no", "why": "The nearest existing model, LADDER, is from 2026 and reports cross-species validation; there is no published number on this paper's data to beat."},
    "guaranteed_improvement": {"answer": "no", "why": "The first condition fails outright: the label the existing models predict (lamina association) is not measured in this download, so this data cannot be added to their inputs or evaluated on their split."}
