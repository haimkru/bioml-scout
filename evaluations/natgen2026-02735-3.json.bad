{
  "paper_id": "natgen2026-02735-3",
  "title": "Dissecting pleiotropy between major depressive disorder and physical disease comorbidities.",
  "doi": "10.1038/s41588-026-02735-3",
  "journal": "Nature Genetics",
  "data_url": "https://doi.org/10.6084/m9.figshare.32916761",
  "verified": {
    "opened_data_files": true,
    "what_i_actually_checked": "Opened all 7 supplementary Excel workbooks from the Europe PMC supplement zip (5.24 MB): workbook MOESM4 holds 52 sheets (ST1-ST52); I counted non-empty rows and confirmed the independent-locus tables ST15-ST18 contain exactly 172, 537, 170 and 140 rows, matching the totals in ST14 and in the Figure-4b source data (1,019 loci total). I queried the figshare API for the deposit (CC BY 4.0, 8 gzipped tab-separated files, 226.96-318.47 MB each), downloaded and read its readme.txt, ran a HEAD on MDD_Gastro_Factor.tsv.gz (HTTP 200, 274,007,460 bytes, application/gzip), and did a ranged GET of the first 300 KB and decompressed the header line: CHR, BP, A1, A2, beta, SE, MAF, P, SNP, Z. I also checked the Zenodo record (code only, CC BY 4.0, R, github.com/damain-wo/MDD-pleio).",
    "what_came_from_paper_text_only": "The per-factor total SNP counts (6,808,623 cardiovascular; 6,862,196 metabolic; 6,747,542 gastrointestinal; 6,470,160 immune) come from supplementary table ST14 and were NOT verified against the downloaded files, because each file is 227-318 MB and exceeds this project's 50 MB download cap. Missingness, duplicate rsID counts and allele-frequency ranges inside the genome-wide files are therefore unchecked. The claim that the Multiple Sclerosis GWAS is 'available on request' and that the Open Targets data came via Google BigQuery is from the data availability statement only."
  },
  "part_a_killers": {
    "a1_downloadable": {"pass": true, "note": "figshare deposit 10.6084/m9.figshare.32916761 is open, CC BY 4.0, no login; HEAD on one file returned HTTP 200 and 274 MB of application/gzip. One upstream input (Multiple Sclerosis GWAS) is request-only, but the four derived factor files we would model are fully open."},
    "a2_label_is_a_column": {"pass": true, "note": "The target is already a column: beta, SE, P and Z per variant, confirmed in the decompressed header line and in the readme. No construction needed."},
    "a3_inputs_present": {"pass": true, "note": "Borderline pass. The files contain only chromosome, base position, alleles and minor allele frequency: no predictive features at all. Features must be built in bulk from external genome-scale resources (GRCh37 reference sequence, functional annotation sets, a linkage-disequilibrium reference panel). That is bulk extraction, not thousands of per-item lookups, so it passes, but it is the single biggest cost of the project."},
    "a4_units_stated": {"pass": true, "note": "readme.txt documents all ten columns and states genome build GRCh37; Z is unitless and beta is on the standardised latent-factor scale produced by genomic structural equation modelling."},
    "a5_enough_rows": {"pass": true, "n_rows": 6747542, "note": "Row count per factor is ~6.8 million (from supplementary table ST14, not verified in the file). But the effective independent unit is the linkage-disequilibrium block, not the variant: only 172/537/170/140 independent loci per factor, 1,019 total, counted by me in ST15-ST18. Passes on raw rows; the honest evaluation n is ~1,000-1,400."},
    "a6_fits_laptop": {"pass": true, "working_set": "~1.2 GB compressed for the four factor files, ~3-5 GB uncompressed; subsetting to a standard ~1.2M-variant panel while streaming brings it under 1 GB", "note": "Passes only with streaming and subsetting. The DNA-language-model route (embedding hundreds of thousands of sequence windows) is not feasible on a 16 GB CPU-only laptop and would need heavy subsetting or a GPU."},
    "a7_counts_match_paper": {"pass": true, "note": "Every count I could check matched exactly: 172/537/170/140 locus rows in ST15-ST18 equal the totals in ST14 and in the Figure-4b source-data workbook. The 6.8M-variant totals could not be checked against the download (file over the 50 MB cap), but no disagreement was observed anywhere."},
    "a8_label_provenance": {"pass": true, "note": "Passes, with a loud warning. The label is not another machine-learning model's prediction: it traces back to measured genotype-phenotype regression coefficients in 31 published GWAS. But it is a deterministic reweighted combination of exactly those 31 GWAS (genomic structural equation modelling), with heterogeneous variants already filtered out by the QSNP step. Any feature drawn from those 31 GWAS, or from any meta-analysis containing their cohorts, is leakage by construction."
  },
  "part_a_verdict": "pass",
  "score_items": {
    "B1": {"score": 1, "why": "Four separate genome-wide files, one per disease cluster, identical schema joining on chromosome:position:alleles; verified header."},
    "B2": {"score": 2, "why": "Clean gzipped tab-separated file; header decompressed cleanly from a 300 KB ranged read."},
    "B3": {"score": 2, "why": "All four factors are on the same standardised genomic structural equation modelling scale; authors already normalised."},
    "B4": {"score": 1, "why": "No censored values expected in summary statistics, but missingness in the minor-allele-frequency column was not verified in the file."},
    "B5": {"score": 1, "why": "Duplicate or multi-allelic rsID rows are common in such files and I could not check; easy to dedupe if present."},
    "B6": {"score": 2, "why": "readme.txt documents all ten columns plus genome build GRCh37; I read it."},
    "C1": {"score": 0, "why": "The realistic question only matters if we beat PolyFun, S-LDSC or AlphaGenome; a null result teaches nothing new."},
    "C2": {"score": 1, "why": "Enformer, AlphaGenome, PolyFun and SBayesRC are open and honestly evaluated on this generic task; none applied to these four factors."},
    "C3": {"score": 1, "why": "Weak angle: the four factor files are genuinely new and unmodelled, but the task class is thoroughly served."},
    "C4": {"score": 1, "why": "Collecting the underlying GWAS is hugely expensive, but the analysis producing these labels is cheap and already done."},
    "C5": {"score": 2, "why": "Published numbers exist (1,019 locus counts in ST14, plus AlphaGenome and PolyFun benchmarks) and obvious dummies exist."},
    "D1": {"score": 2, "why": "Open-weight DNA backbones match genomic coordinates: Nucleotide Transformer, DNABERT-2, HyenaDNA; AlphaGenome weights non-commercial."},
    "D2": {"score": 1, "why": "Caching embeddings for ~1M sequence windows on a CPU-only laptop is not viable; only a heavy subset works."},
    "D3": {"score": 2, "why": "Data is CC BY 4.0 (verified on figshare); HyenaDNA and DNABERT-2 carry permissive licences."},
    "E1": {"ok": true, "why": "Leave-one-chromosome-out or leave-one-linkage-disequilibrium-block-out split is standard and the coordinate column supports it."},
    "E2": {"ok": true, "why": "22 chromosomes and roughly 1,300-1,700 near-independent linkage-disequilibrium blocks genome-wide give plenty of hold-out groups."},
    "E3": {"ok": true, "why": "Per-allele-frequency-bin mean absolute Z, or a gene-density-only predictor, are obvious dummy baselines."},
    "E4": {"ok": true, "why": "The standard error column gives a per-variant noise estimate directly; the QSNP and non-QSNP file pairs give a second handle."},
    "E5": {"ok": true, "why": "Well-known depression loci (the chromosome 1 NEGR1 region, the DRD2 region seen in ST25-ST29) must be recovered."},
    "E6": {"ok": true, "why": "Label shuffling within linkage-disequilibrium block and annotation-block ablation are both cheap to run."},
    "E7": {"ok": true, "why": "Independent published depression GWAS (for example the 2024 trans-ancestry depression study) and the paired no-QSNP files allow external checks."},
    "E8": {"ok": true, "why": "The 172/537/170/140 locus counts in ST14 can be reproduced by clumping the downloaded files with PLINK."},
    "G1": {"score": 2, "why": "Standard identifiers present and verified in the header: rsID plus GRCh37 chromosome and base position."},
    "G2": {"score": 2, "why": "Named joinable partners: GTEx v8 expression, the Open Targets Platform, and the AlphaGenome Atlas of precomputed variant effects."},
    "G3": {"score": 1, "why": "Coordinate joins are manageable but need build harmonisation and multi-allelic collapse rules; one variant maps to many genes."},
    "G4": {"score": 1, "why": "Combination gives better variant prioritisation at gut-brain-axis loci, but that is a refinement, not a question neither could answer."},
    "H1": {"score": 2, "why": "Genome-wide files include all variants, significant and null, so negatives are systematically present, not just hits."},
    "H2": {"score": 0, "why": "Every constituent GWAS is European-ancestry; one analysis framework, one build, no ancestry diversity."},
    "H3": {"score": 2, "why": "The honest claim can be written precisely in one sentence (see honest_claim_h3)."},
    "H4": {"score": 2, "why": "Supplementary tables ST1 and ST10 list every input trait, sample size and PMID, so the gaps are explicit."},
    "I1": {"score": 1, "why": "Psychiatric-genetics groups such as the authors at QIMR Berghofer, but no named group waiting on this prediction."},
    "I2": {"score": 1, "why": "A better variant ranking might redirect follow-up experiments marginally; it would not change a clinical or lab decision."},
    "I3": {"score": 1, "why": "Ranking metrics roughly match the prioritisation decision, but the decision is made with fine-mapping posteriors, not model scores."},
    "I4": {"score": 0, "why": "Established statistical methods (stratified linkage-disequilibrium score regression, PolyFun) already do this job better than generic machine learning."},
    "J1": {"score": 1, "why": "Real splits and transfer learning, but the bulk of the work is genome-scale plumbing and annotation assembly."},
    "J2": {"score": 0, "why": "Judging sensible output needs statistical-genetics intuition about linkage disequilibrium and winner's curse; easy to fool yourself."},
    "J3": {"score": 1, "why": "A harmonised four-factor variant table would be shareable even if the model fails, but it duplicates the figshare deposit."},
    "J4": {"score": 1, "why": "Could be bounded at four to six weeks, but the annotation build makes the estimate soft."},
    "J5": {"score": 1, "why": "A kill condition is statable (no gain over a frequency-and-gene-density dummy), but nothing is written down yet."}
  },
  "c2_audit": {
    "existing_models": [
      {
        "name": "PolyFun with stratified linkage-disequilibrium score regression (functionally informed fine-mapping)",
        "open_weights": true,
        "score_and_split": "Published applications report functionally informed fine-mapping finding 101 causal variants versus 87 by statistical fine-mapping alone, using 3 Mb linkage-disequilibrium blocks with 1 Mb overlap; evaluated across dozens of UK Biobank traits.",
        "authors_named_unsolved": "Accuracy depends on the linkage-disequilibrium reference panel matching the GWAS cohort, and performance outside European ancestry is unresolved.",
        "runnable_as_baseline": true
      },
      {
        "name": "Enformer (a deep neural network predicting regulatory activity from DNA sequence)",
        "open_weights": true,
        "score_and_split": "Predicts gene expression and chromatin signals across >5,000 genome profiles using up to 100 kb of context; evaluated on held-out genomic regions, and its variant-effect scores are reported as enriched for trait heritability.",
        "authors_named_unsolved": "Benchmarks found weak performance on personal (between-individual) expression variation, which is exactly the regime GWAS signal lives in.",
        "runnable_as_baseline": false
      },
      {
        "name": "AlphaGenome (a unified DNA sequence model from Google DeepMind)",
        "open_weights": null,
