  "backbone": {"name": "AlphaGenome or Nucleotide Transformer (DNA sequence models) for variant-window embeddings", "freeze_and_head_viable": true, "hardware": "Embeddings for ~1-2k loci are feasible on CPU over days, or a few hours on a rented GPU; a gradient-boosting baseline on annotations needs neither.", "licence": "AlphaGenome weights are non-commercial; Nucleotide Transformer is permissive. The data itself is CC BY 4.0."},
  "integration": {"partner_dataset": "Open Targets Genetics / GWAS Catalog and GTEx v8, joinable to these variants", "join_key": "rsID or GRCh37 chromosome:position:alleles", "bigger_question_one_sentence": "Do variants carrying shared depression-plus-physical-disease liability sit in different tissues' regulatory elements than variants specific to either side?"},
  "controls": {"positive_control": "A model given annotations should recover the known enrichment of GWAS signal in conserved and promoter/enhancer regions.", "negative_control": "Shuffle the factor Z-scores within LD blocks and confirm performance collapses to the per-block mean.", "external_validation": "The depression-only GWAS and the 24 constituent disease GWAS (Supplementary Table 1) give held-out traits, but they are the same data the label was built from, so they are not independent."},
  "honest_claim_h3": "A model here could only claim to predict the genomic-SEM-estimated strength of a variant's association with a depression-disease latent factor, among European-ancestry GWAS of the 24 traits these authors chose, at whatever statistical power those particular GWAS happened to have - not any measured property of the variant.",
  "plain_idea": {
    "one_liner": "Use DNA sequence and functional annotation around each variant to predict its contribution to shared depression-physical disease genetic liability.",
    "train_on": "Each example is one genetic variant described by its surrounding DNA sequence and regulatory annotations; roughly 6.5 million variants per factor are listed, but only about 1,019 independent genome-wide-significant loci across the four factors, and ~1,700 independent linkage blocks genome-wide.",
    "predict": "The per-variant effect size or Z-score for a depression-disease latent factor. The true answer is not a measurement: it is an estimate produced by genomic structural equation modelling applied to 24 published disease GWAS.",
    "why_worthwhile": "If it worked, psychiatric genetics groups could tell shared-liability variants from disease-specific ones without rerunning multivariate models; as it stands, the target is a statistic rather than a measured quantity, so the exercise mostly recovers the statistics' own power profile."
  },
  "paper_type": "computational",
  "crowded_field_case": {
    "more_or_better_data": {"answer": "no", "why": "The eight factor files are derived from 24 public GWAS that variant-prioritisation models such as FLAMES and the V2D framework already use; nothing here is a new measurement, and the 1,019 significant loci are fewer than those models train on."},
    "confidence_score": {"answer": "partly", "why": "Standard errors are supplied per SNP, so uncertainty is quantified - but it is the uncertainty of the genomic SEM estimate, not of any biological measurement, and there are no replicate measurements to calibrate against."},
    "models_beatable": {"answer": "no", "why": "AlphaGenome (2025/2026) and the 2025 FLAMES and V2D frameworks are recent, open or partly open, and evaluated on fine-mapped loci; beating them on a power-dependent derived statistic would not be a meaningful win."},
    "guaranteed_improvement": {"answer": "no", "why": "The constituent GWAS that could be joined in are exactly the data the label was computed from, so adding them guarantees leakage rather than improvement; no independent measurement of the same quantity exists."}
  },
  "label_elsewhere": null,
